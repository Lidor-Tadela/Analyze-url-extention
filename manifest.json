{
  "manifest_version": 3,
  "name": "Chapter URL Incrementer",
  "version": "1.0",
  "description": "Automatically increment chapter numbers in URLs",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://toonily.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://toonily.com/serie/*/chapter-*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Chapter URL Incrementer",
    "default_icon": "icon.png"
  }
}